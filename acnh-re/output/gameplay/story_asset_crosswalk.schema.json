{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acnh-re/story-asset-crosswalk-part/1",
  "title": "ACNH story to asset crosswalk part",
  "type": "object",
  "required": ["schema", "scope", "items"],
  "properties": {
    "schema": {"const": "acnh-re/story-asset-crosswalk-part/1"},
    "scope": {"type": "string"},
    "asset_inventory": {"type": "object"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/beat"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["STRUCT", "EF", "TBL", "NATIVE", "PSEUDO", "CROSS", "CAT", "OPEN"]
    },
    "reference": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "key": {"type": ["string", "number", "null"]},
        "source": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/status"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "beat": {
      "type": "object",
      "required": [
        "beat_id", "order", "flow", "stage", "actors", "actions",
        "items", "structures", "placements", "assets", "evidence", "gaps"
      ],
      "properties": {
        "beat_id": {"type": "string"},
        "order": {"type": "integer", "minimum": 0},
        "title": {"type": "string"},
        "flow": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
        "stage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
        "actors": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "structures": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "placements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
        "assets": {
          "type": "object",
          "required": [
            "ui", "animation", "model", "audio", "text", "texture",
            "material_shader", "effect", "font", "world_data", "collision"
          ],
          "properties": {
            "ui": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "animation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "model": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "audio": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "text": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "texture": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "material_shader": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "effect": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "font": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "world_data": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "collision": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
            "other": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
          },
          "additionalProperties": true
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "gaps": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
